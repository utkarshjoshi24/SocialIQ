# Root Environment Configuration Template for SocialIQ

# Backend (Node/Express)
PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/socialiq
# Required in production: a random value of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left empty, development uses a random per-process secret (sessions reset on restart).
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed by CORS
CLIENT_URL=http://localhost:5173

# Python Analytics & ML Service
FLASK_ANALYTICS_URL=http://localhost:5002
FLASK_PORT=5002
FLASK_ENV=development
